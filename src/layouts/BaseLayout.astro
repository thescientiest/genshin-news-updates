---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Automated Genshin Impact news, updates, and community breakdowns from official uploads.",
  image = "https://i.ytimg.com/vi/rEoZ_t5oBmQ/hqdefault.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><polygon points='50,5 90,50 50,95 10,50' fill='%23f59e0b'/></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Teyvat Chronicle</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph & Social Previews -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <div class="site-wrapper">
      <header class="site-header">
        <div class="container nav-container">
          <a href="/" class="brand-logo">
            <span class="logo-icon">✦</span>
            <span class="brand-text">Teyvat<strong>Chronicle</strong></span>
          </a>
          <nav class="nav-links">
            <a href="/">Latest Articles</a>
            <a href="/tags">Tags</a>
            <a href="/about">About</a>
          </nav>
        </div>
      </header>

      <main class="container main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container footer-container">
          <p class="disclaimer">
            Teyvat Chronicle is an unofficial, non-commercial fan project. Genshin Impact and all related assets, logos, and audio are trademarks or registered trademarks of COGNOSPHERE PTE. LTD.
          </p>
          <div class="footer-links">
            <a href="https://www.youtube.com/@GenshinImpact" target="_blank" rel="noopener noreferrer">Official YouTube</a>
            <span>•</span>
            <a href="/about">About This Project</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #0b1120;
    --bg-card: #151f33;
    --bg-card-hover: #1c2a45;
    --border-color: rgba(245, 158, 11, 0.2);
    --border-subtle: rgba(255, 255, 255, 0.08);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --gold: #f59e0b;
    --gold-light: #fbbf24;
    --gold-glow: rgba(245, 158, 11, 0.25);
    --cyan: #38bdf8;
    --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: var(--font-family);
    line-height: 1.6;
    min-height: 100vh;
    background-image: 
      radial-gradient(ellipse at 50% 0%, rgba(30, 58, 138, 0.3) 0%, transparent 75%),
      radial-gradient(circle at 85% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%);
    background-attachment: fixed;
  }

  a {
    color: var(--gold-light);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: #ffffff;
  }

  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-header {
    border-bottom: 1px solid var(--border-subtle);
    background-color: rgba(11, 17, 32, 0.85);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.3rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .logo-icon {
    color: var(--gold);
    font-size: 1.5rem;
    text-shadow: 0 0 10px var(--gold-glow);
  }

  .brand-text strong {
    color: var(--gold);
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--gold);
  }

  .main-content {
    flex: 1;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background-color: rgba(11, 17, 32, 0.9);
    padding: 2.5rem 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  .footer-links a {
    color: var(--text-secondary);
  }

  /* Shared Typography & Badge styles */
  .badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    background-color: rgba(245, 158, 11, 0.12);
    color: var(--gold-light);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .badge:hover {
    background-color: rgba(245, 158, 11, 0.25);
    border-color: var(--gold);
  }
</style>
