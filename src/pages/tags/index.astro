---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => data.draft !== true);

// Count tags
const tagCounts = new Map<string, number>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    const count = tagCounts.get(tag) || 0;
    tagCounts.set(tag, count + 1);
  }
}

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Article Topics & Tags">
  <div class="tags-header">
    <h1>Topics & Categories</h1>
    <p>Browse official updates, characters, events, and animation cutscenes by tag.</p>
  </div>

  {sortedTags.length > 0 ? (
    <div class="tags-cloud">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="tag-card">
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">{count} {count === 1 ? 'article' : 'articles'}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <p>No published tags available yet.</p>
    </div>
  )}
</BaseLayout>

<style>
  .tags-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .tags-header h1 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }

  .tags-header p {
    color: var(--text-secondary);
  }

  .tags-cloud {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .tag-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tag-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
    background-color: var(--bg-card-hover);
  }

  .tag-name {
    font-weight: 600;
    color: var(--gold-light);
  }

  .tag-count {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 3rem;
  }
</style>
