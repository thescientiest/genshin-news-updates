---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.draft !== true);
  
  // Extract all unique lowercased tags
  const tags = new Set<string>();
  articles.forEach((article) => {
    article.data.tags.forEach((tag) => {
      tags.add(tag.toLowerCase());
    });
  });

  return Array.from(tags).map((tag) => {
    const filteredArticles = articles.filter((article) =>
      article.data.tags.some((t) => t.toLowerCase() === tag)
    );
    // Sort newest first
    filteredArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    // Find original casing for display
    const originalTag = filteredArticles[0]?.data.tags.find((t) => t.toLowerCase() === tag) || tag;

    return {
      params: { tag },
      props: {
        tagName: originalTag,
        articles: filteredArticles,
      },
    };
  });
}

const { tag } = Astro.params;
const { tagName, articles } = Astro.props;
---

<BaseLayout title={`Articles Tagged with #${tagName}`}>
  <div class="tag-header">
    <div class="back-nav">
      <a href="/tags">← Back to All Tags</a>
    </div>
    <h1>Tag: <span class="tag-highlight">#{tagName}</span></h1>
    <p>{articles.length} {articles.length === 1 ? 'article' : 'articles'} found</p>
  </div>

  <div class="articles-grid">
    {articles.map((article) => (
      <ArticleCard
        title={article.data.title}
        date={article.data.date}
        slug={article.slug}
        tags={article.data.tags}
        videoId={article.data.videoId}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .tag-header {
    margin-bottom: 2.5rem;
  }

  .back-nav {
    margin-bottom: 1rem;
  }

  .back-nav a {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .back-nav a:hover {
    color: var(--gold);
  }

  .tag-header h1 {
    font-size: 2.2rem;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .tag-highlight {
    color: var(--gold);
  }

  .tag-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .articles-grid {
    display: grid;
    gap: 1.5rem;
  }
</style>
