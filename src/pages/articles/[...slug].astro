---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(article.data.date);
---

<BaseLayout 
  title={article.data.title}
  image={`https://i.ytimg.com/vi/${article.data.videoId}/hqdefault.jpg`}
>
  <article class="article-detail">
    <div class="back-nav">
      <a href="/" class="back-link">← Back to All Articles</a>
      {article.data.draft && <span class="draft-badge">Draft Preview</span>}
    </div>

    <header class="article-header">
      <h1 class="article-title">{article.data.title}</h1>
      <div class="article-meta">
        <time datetime={article.data.date.toISOString()}>Published: {formattedDate}</time>
        <span class="meta-separator">•</span>
        <span class="source-credit">
          Source: <a href="https://www.youtube.com/@GenshinImpact" target="_blank" rel="noopener noreferrer">@GenshinImpact</a>
        </span>
      </div>

      <div class="article-tags">
        {article.data.tags.map((tag: string) => (
          <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="badge">
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <!-- Embedded YouTube Video -->
    <VideoEmbed videoId={article.data.videoId} title={article.data.title} />

    <!-- Article Content -->
    <div class="markdown-body">
      <Content />
    </div>

    <section class="channel-credit-box">
      <h3>Official Channel Attribution</h3>
      <p>
        This article was generated based on the official video uploaded by 
        <strong>Genshin Impact</strong> on YouTube. All rights, characters, and visuals belong to COGNOSPHERE PTE. LTD.
      </p>
      <a 
        href={`https://www.youtube.com/watch?v=${article.data.videoId}`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="channel-button"
      >
        Watch Original on YouTube ↗
      </a>
    </section>
  </article>
</BaseLayout>

<style>
  .article-detail {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .back-link:hover {
    color: var(--gold);
  }

  .draft-badge {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-title {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* Markdown body styles */
  .markdown-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #e2e8f0;
  }

  .markdown-body :global(h2) {
    font-size: 1.45rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--gold-light);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.4rem;
  }

  .markdown-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .markdown-body :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .channel-credit-box {
    margin-top: 3.5rem;
    padding: 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-align: center;
  }

  .channel-credit-box h3 {
    font-size: 1.1rem;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .channel-credit-box p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .channel-button {
    display: inline-block;
    background: linear-gradient(135deg, var(--gold) 0%, #d97706 100%);
    color: #0b1120;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .channel-button:hover {
    color: #0b1120;
    transform: translateY(-1px);
    opacity: 0.95;
  }
</style>
